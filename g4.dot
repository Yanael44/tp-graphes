graph {
    // Style global (Q1.10 et Q1.13)
    node [fontsize="16pt", fontcolor="red", shape="box"];
    edge [fontsize="14pt", fontcolor="blue"];

    // Positions absolues sur la grille (Q1.11)
    F [pos="1,2!"];
    G [pos="1,5!"];
    H [pos="3,7!"];
    D [pos="4,4!"];
    E [pos="4,1!"];
    B [pos="6,7!"];
    C [pos="6,4!"];
    A [pos="9,5!"];

    // Liaisons
    A -- B [label="1"];
    A -- C [label="4"];
    B -- H [label="2"];
    B -- G [label="4"];
    B -- D [label="3"];
    B -- C [label="2"];
    C -- D [label="1"];
    C -- E [label="3"];
    D -- G [label="1"];
    D -- F [label="3"];
    D -- E [label="1"];
    E -- F [label="1"];
    F -- G [label="6"];
    G -- H [label="14"];
}
